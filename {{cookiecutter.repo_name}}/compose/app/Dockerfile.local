FROM node:24.18.0-bookworm-slim AS node

FROM python:3.12.13-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ={{ cookiecutter.timezone }}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        libjpeg-dev \
        zlib1g-dev \
        libffi-dev \
        libssl-dev \
        gettext \
        locales \
        postgresql-client \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN localedef -f UTF-8 -i en_US en_US.utf8

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN python -m venv "$VIRTUAL_ENV"
COPY {{cookiecutter.repo_name}}/requirements /tmp/requirements
# pip >= 26.2.2 drops the compromised eMudhra/emSign CAs from its bundle;
# pinned by URL + sha256 so the download itself can't be tampered with.
RUN pip install --no-cache-dir "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
RUN pip install --no-cache-dir -r /tmp/requirements/local.txt

WORKDIR /home/app/{{cookiecutter.repo_name}}
